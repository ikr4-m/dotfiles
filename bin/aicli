#!/usr/bin/env bash
set -euo pipefail

KNOWN_AGENTS=("opencode" "claude" "agy" "codex")
USED_BINARY=("tmux" "git" "fzf")

missing_count=0
for bin in "${USED_BINARY[@]}"; do
    if ! command -v "$bin" >/dev/null 2>&1; then
        echo "$bin is not installed" >&2
        missing_count=$((missing_count + 1))
    fi
done
if (( missing_count > 0 )); then
    exit 1
fi

# shellcheck disable=SC2059
show_motd() {
    local root="${1:-$PWD}"
    local agent="${2:-agent}"
    local folder
    folder="$(basename "$root")"
    local branch=""
    if git -C "$root" rev-parse --is-inside-work-tree >/dev/null 2>&1; then
        branch="$(git -C "$root" rev-parse --abbrev-ref HEAD 2>/dev/null || echo "")"
    fi

    local c_cyan="\033[1;36m"
    local c_green="\033[1;32m"
    local c_yellow="\033[1;33m"
    local c_dim="\033[2m"
    local c_reset="\033[0m"

    echo ""
    printf "  ${c_cyan}⚡ aicli${c_reset} ${c_dim}•${c_reset} \033[1m%s\033[0m\n" "$folder"
    printf "  ${c_dim}├─${c_reset} Root   : %s\n" "$root"
    if [[ -n "$branch" ]]; then
        printf "  ${c_dim}├─${c_reset} Branch : ${c_green}%s${c_reset}\n" "$branch"
    fi
    printf "  ${c_dim}├─${c_reset} Agent  : ${c_yellow}%s${c_reset} ${c_dim}(Left Pane)${c_reset}\n" "$agent"
    printf "  ${c_dim}└─${c_reset} Info   : ${c_dim}Use 'aicli <agent>' to summon more agent windows${c_reset}\n"
    echo ""
}

# Internal handler to display MOTD and drop into user's interactive shell
if [[ "${1:-}" == "--motd" ]]; then
    shift
    MOTD_ROOT="${1:-$PWD}"
    MOTD_AGENT="${2:-agent}"
    show_motd "$MOTD_ROOT" "$MOTD_AGENT"
    exec "${SHELL:-/bin/bash}"
fi

# Internal handler to calculate tmux session uptime
if [[ "${1:-}" == "--uptime" ]]; then
    shift
    start="${1:-$(date +%s)}"
    now="$(date +%s)"
    diff=$((now - start))
    d=$((diff / 86400))
    h=$(((diff % 86400) / 3600))
    m=$(((diff % 3600) / 60))
    out=""
    (( d > 0 )) && out="${d}d "
    (( h > 0 )) && out="${out}${h}h "
    out="${out}${m}m"
    echo "$out"
    exit 0
fi

show_help() {
    cat <<EOF
Usage: $(basename "$0") [AGENT] [ARGS...]
       $(basename "$0") exec <AGENT> [ARGS...]

Launch an AI agent CLI alongside a terminal in the project root inside tmux.
If called when a session already exists, summons a new agent window.

Commands:
  exec <AGENT>  Run the agent directly in the current terminal with presets applied (no tmux)

Supported Agents:
  opencode (default)
  claude
  agy
  codex
  <custom-command>

Options:
  -h, --help    Show this help message
EOF
}
if [[ "${1:-}" == "-h" || "${1:-}" == "--help" ]]; then
    show_help
    exit 0
fi

# In-place execution mode without tmux
if [[ "${1:-}" == "exec" || "${1:-}" == "run" ]]; then
    shift
    if [[ $# -eq 0 ]]; then
        echo "Error: 'exec' requires an agent name." >&2
        exit 1
    fi
    EXEC_AGENT="$1"
    shift
    EXEC_ARGS=("$@")
    case "$EXEC_AGENT" in
        agy)
            export AGY_CLI_HIDE_ACCOUNT_INFO=true
            if [[ ! " ${EXEC_ARGS[*]:-} " =~ " --dangerously-skip-permissions " ]]; then
                EXEC_ARGS=("--dangerously-skip-permissions" "${EXEC_ARGS[@]}")
            fi
            ;;
    esac
    exec "$EXEC_AGENT" "${EXEC_ARGS[@]}"
fi

# Detect project root directory and sanitize session name
PROJECT_ROOT="$(git rev-parse --show-toplevel 2>/dev/null || pwd)"
FOLDER_NAME="$(basename "$PROJECT_ROOT" | tr '.: ' '___')"
SESSION_NAME="aicli-${FOLDER_NAME}"

# Check if session already exists
SESSION_EXISTS=false
if tmux has-session -t "$SESSION_NAME" 2>/dev/null; then
    SESSION_EXISTS=true
fi

# If session exists and user didn't specify arguments:
# - Outside tmux: attach to existing session
# - Inside tmux (different session): switch to existing session
# - Inside this session: fall through to fzf prompt to select another agent window
if $SESSION_EXISTS && [[ $# -eq 0 ]]; then
    if [[ -n "${TMUX:-}" ]]; then
        CURRENT_SESSION="$(tmux display-message -p '#S' 2>/dev/null || echo '')"
        if [[ "$CURRENT_SESSION" != "$SESSION_NAME" ]]; then
            exec tmux switch-client -t "$SESSION_NAME"
        fi
    else
        exec tmux attach-session -t "$SESSION_NAME"
    fi
fi

# Determine agent and arguments
if [[ $# -gt 0 ]]; then
    AGENT="$1"
    shift
    AGENT_ARGS=("$@")
else
    if [[ -t 0 ]] && command -v fzf >/dev/null 2>&1; then
        AGENT="$(printf "%s\n" "${KNOWN_AGENTS[@]}" | fzf --prompt="Select AI Agent: " --header="[Default: opencode]" || true)"
        [[ -z "$AGENT" ]] && AGENT="opencode"
    elif [[ -t 0 ]]; then
        echo "Select AI Agent [default: opencode]:"
        select opt in "${KNOWN_AGENTS[@]}"; do
            AGENT="${opt:-opencode}"
            break
        done
        [[ -z "${AGENT:-}" ]] && AGENT="opencode"
    else
        AGENT="opencode"
    fi
    AGENT_ARGS=()
fi

# Agent-specific defaults and configuration
ENV_PREFIX=""
case "$AGENT" in
    agy)
        ENV_PREFIX="AGY_CLI_HIDE_ACCOUNT_INFO=true "
        export AGY_CLI_HIDE_ACCOUNT_INFO=true
        if [[ ! " ${AGENT_ARGS[*]:-} " =~ " --dangerously-skip-permissions " ]]; then
            AGENT_ARGS=("--dangerously-skip-permissions" "${AGENT_ARGS[@]}")
        fi
        ;;
esac

if ! command -v "$AGENT" >/dev/null 2>&1; then
    echo "Warning: '$AGENT' was not found in PATH." >&2
fi

printf -v ESCAPED_AGENT '%q' "$AGENT"
if [[ ${#AGENT_ARGS[@]} -gt 0 ]]; then
    printf -v ESCAPED_ARGS '%q ' "${AGENT_ARGS[@]}"
    FULL_CMD="${ENV_PREFIX}${ESCAPED_AGENT} ${ESCAPED_ARGS}"
else
    FULL_CMD="${ENV_PREFIX}${ESCAPED_AGENT}"
fi

# Drop into interactive shell when agent exits so output/scrollback is preserved
RUN_CMD="${FULL_CMD}; exec \${SHELL:-/bin/bash}"

# Resolve absolute path to this script (for MOTD default-command)
AICLI_BIN="$(readlink -f "$0" 2>/dev/null || realpath "$0" 2>/dev/null || echo "$0")"

# If session already exists, spawn a new window for this agent
if $SESSION_EXISTS; then
    AGENT_PANE_ID="$(tmux new-window -d -t "$SESSION_NAME" -n "$AGENT" -c "$PROJECT_ROOT" -P -F "#{pane_id}" "$RUN_CMD")"
    tmux set-option -w -t "$AGENT_PANE_ID" default-command 'bash -c "\"${AICLI_BIN}\" --motd \"${PROJECT_ROOT}\" \"${AGENT}\""'
    tmux split-window -h -t "$AGENT_PANE_ID" -c "$PROJECT_ROOT"
    tmux select-pane -t "$AGENT_PANE_ID"
    tmux select-window -t "$AGENT_PANE_ID"

    if [[ -n "${TMUX:-}" ]]; then
        CURRENT_SESSION="$(tmux display-message -p '#S' 2>/dev/null || echo '')"
        if [[ "$CURRENT_SESSION" != "$SESSION_NAME" ]]; then
            exec tmux switch-client -t "$SESSION_NAME"
        fi
        exit 0
    else
        exec tmux attach-session -t "$SESSION_NAME"
    fi
fi

# Create new session with the AI agent in the first pane
AGENT_PANE_ID="$(tmux new-session -d -s "$SESSION_NAME" -c "$PROJECT_ROOT" -P -F "#{pane_id}" "$RUN_CMD")"

# Generate temp tmux config with session options
AICLI_CONF="$(mktemp /tmp/aicli-XXXXXX.tmux.conf)"
trap 'rm -f "$AICLI_CONF"' EXIT

cat > "$AICLI_CONF" <<TMUX_CONF
# Session metadata
set-option -t "${SESSION_NAME}" @aicli_project_root "${PROJECT_ROOT}"

# Mouse support (click to switch panes, scroll, resize)
set-option -t "${SESSION_NAME}" mouse on

# Vi mode in copy mode (Ctrl+B > [)
set-option -t "${SESSION_NAME}" mode-keys vi

# MOTD on all new panes
set-option -t "${SESSION_NAME}" default-command 'bash -c "\"${AICLI_BIN}\" --motd \"${PROJECT_ROOT}\" \"${AGENT}\""'

# Bottom status bar configuration (dynamic terminal palette colors)
set-option -t "${SESSION_NAME}" status on
set-option -t "${SESSION_NAME}" status-position bottom
set-option -t "${SESSION_NAME}" status-interval 5
set-option -t "${SESSION_NAME}" status-left-length 80
set-option -t "${SESSION_NAME}" status-right-length 120
set-option -t "${SESSION_NAME}" status-style "bg=default,fg=default"

# Window list tabs
set-option -t "${SESSION_NAME}" window-status-format "#[fg=colour245,bg=default] #I:#W "
set-option -t "${SESSION_NAME}" window-status-current-format "#[fg=black,bg=cyan,bold] #I:#W #[default]"
set-option -t "${SESSION_NAME}" window-status-separator ""

# Left bar: session name + tmux uptime
set-option -t "${SESSION_NAME}" status-left "#[fg=black,bg=cyan,bold]  #S #[default] 󰔛 #(\"${AICLI_BIN}\" --uptime #{session_created}) "

# Right bar: date & time + user@hostname
set-option -t "${SESSION_NAME}" status-right "  %d %b %Y │  %H:%M #[fg=black,bg=blue,bold]  ${USER}@#h #[default]"
TMUX_CONF

tmux source-file "$AICLI_CONF"

# Split window horizontally to add a terminal pane on the right (at project root)
tmux split-window -h -t "$AGENT_PANE_ID" -c "$PROJECT_ROOT"

# Focus back on the AI Agent pane
tmux select-pane -t "$AGENT_PANE_ID"

# Vi-style pane navigation (prefix + h/j/k/l) for aicli sessions
tmux bind-key -T prefix h if-shell -F "#{m:aicli-*,#{session_name}}" \
    "select-pane -L" "select-pane -L"
tmux bind-key -T prefix j if-shell -F "#{m:aicli-*,#{session_name}}" \
    "select-pane -D" "select-pane -D"
tmux bind-key -T prefix k if-shell -F "#{m:aicli-*,#{session_name}}" \
    "select-pane -U" "select-pane -U"
tmux bind-key -T prefix l if-shell -F "#{m:aicli-*,#{session_name}}" \
    "select-pane -R" "select-pane -R"

# Override keybinding split on the current session
tmux bind-key -T prefix % if-shell -F "#{m:aicli-*,#{session_name}}" \
    "split-window -h -c '#{@aicli_project_root}'" \
    "split-window -h -c '#{pane_current_path}'"
tmux bind-key -T prefix - if-shell -F "#{m:aicli-*,#{session_name}}" \
    "split-window -v -c '#{@aicli_project_root}'" \
    "split-window -v -c '#{pane_current_path}'"
tmux bind-key -T prefix \" if-shell -F "#{m:aicli-*,#{session_name}}" \
    "split-window -v -c '#{@aicli_project_root}'" \
    "split-window -c '#{pane_current_path}'"
tmux bind-key -T prefix _ if-shell -F "#{m:aicli-*,#{session_name}}" \
    "split-window -h -c '#{@aicli_project_root}'" \
    "split-window -h -c '#{pane_current_path}'"

# Attach or switch client to the session
if [[ -n "${TMUX:-}" ]]; then
    exec tmux switch-client -t "$SESSION_NAME"
else
    exec tmux attach-session -t "$SESSION_NAME"
fi
